# Local defaults. Keep OAuth credentials and the local application token outside
# the repository (for example in C:\Source\supermarket-evolution\secrets).
SUPERMARKET_BIND_HOST=127.0.0.1
SUPERMARKET_BIND_PORT=8000
SUPERMARKET_DATABASE_URL=sqlite+aiosqlite:///./supermarket-evolution.db
SUPERMARKET_FRONTEND_DIST_DIRECTORY=../frontend/dist
SUPERMARKET_CORS_ORIGINS=["http://localhost:5173"]
SUPERMARKET_GMAIL_ACCOUNT=dantecampoy@gmail.com
SUPERMARKET_GMAIL_SENDER=ticket_digital@mail.mercadona.com
SUPERMARKET_GMAIL_CLIENT_SECRETS_PATH=../../secrets/gmail-client-secret.json
SUPERMARKET_GMAIL_TOKEN_PATH=../../secrets/gmail-token.json
SUPERMARKET_TICKETS_DIRECTORY=../../tickets
